# Copy to .env for local development. Never commit .env.
# Values for local Supabase come from `npx supabase start` output.
#
# These are for running on THIS machine only. A build handed to anyone else
# needs a hosted project instead, because a loopback address resolves to the
# tester's own phone and nothing is listening there. Builds take their values
# from EAS environment variables, not from this file:
#   npx eas env:create --environment preview --name EXPO_PUBLIC_SUPABASE_URL --value https://<ref>.supabase.co
# See docs/TESTING_PROGRAM.md, and verify with `npm run check:backend` before
# building for anyone.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Optional: OAuth provider credentials for the local Supabase stack.
# Leave unset to develop with email and password only.
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Optional: Sentry crash reporting DSN. Inert when unset.
EXPO_PUBLIC_SENTRY_DSN=

# Optional: Supabase Storage image transformations, applied at render time by
# src/lib/image-url.ts. Off unless this is exactly "true". Turn it on only after
# confirming the render endpoint answers on your Supabase plan, because if it
# does not, every avatar and poster fails to load rather than falling back.
EXPO_PUBLIC_IMAGE_TRANSFORMS_ENABLED=

# Optional: platform age signal (Apple Declared Age Range, Google Play age
# signals) at signup. Off unless exactly "true". Build-time value: flipping
# it requires a new build, not just new env.
EXPO_PUBLIC_AGE_SIGNAL_ENABLED=
