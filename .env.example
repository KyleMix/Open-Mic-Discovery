# Copy to .env for local development. Never commit .env.
# Values for local Supabase come from `npx supabase start` output.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Optional: OAuth provider credentials for the local Supabase stack.
# Leave unset to develop with email and password only.
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Optional: RevenueCat public SDK keys for Producer Pro (Phase 7).
# Without them, dev builds unlock Pro for testing; production builds fail closed.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Optional: Sentry crash reporting DSN. Inert when unset.
EXPO_PUBLIC_SENTRY_DSN=
